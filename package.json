    "db:studio": "dotenv -e .env.local -- drizzle-kit studio",
    "db:seed-timezones": "dotenv -e .env.local -- tsx scripts/seed-timezones.ts",
    "db:seed-currencies": "dotenv -e .env.local -- tsx scripts/seed-currencies.ts",
    "db:truncate-inventory": "dotenv -e .env.local -- tsx scripts/truncate-inventory.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-table": "^8.21.3",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "drizzle-orm": "^0.45.2",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.33.0",
    "next": "16.3.2",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.0.5",
